# FastAPI Configuration
APP_NAME=HeatGuard AI
APP_VERSION=1.0.0
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000

# FortyGuard API Configuration (Add your key here on August 18)
FORTYGUARD_API_KEY=your_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com/v1

# AI Provider Configuration (Optional - for future LLM integration)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=rule-based  # Options: rule-based, openai, anthropic

# Mock Data Settings
USE_MOCK_DATA=true  # Set to false when real API is available
