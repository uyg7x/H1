# HeatGuard AI Frontend Environment Configuration

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# FortyGuard API Configuration (Add your key here on August 18)
NEXT_PUBLIC_FORTYGUARD_API_KEY=your_api_key_here

# AI Provider Configuration (Optional)
NEXT_PUBLIC_OPENAI_API_KEY=
NEXT_PUBLIC_ANTHROPIC_API_KEY=

# Application Settings
NEXT_PUBLIC_APP_NAME=HeatGuard AI
NEXT_PUBLIC_APP_VERSION=1.0.0

# Map Configuration
NEXT_PUBLIC_MAP_DEFAULT_CENTER=33.4484,-112.0740
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=12

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_CHAT=true
NEXT_PUBLIC_ENABLE_ROUTE_PLANNING=true
NEXT_PUBLIC_ENABLE_EMERGENCY_ALERTS=true
NEXT_PUBLIC_ENABLE_MOCK_DATA=true

# Analytics (Optional)
NEXT_PUBLIC_GA_TRACKING_ID=
